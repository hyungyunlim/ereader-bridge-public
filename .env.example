# Kavita API key (Kavita: User settings -> API Key). Enables paper -> EPUB sync (/sync, /locate).
KAVITA_API_KEY=
# Audiobookshelf API key (Audiobookshelf: Settings -> API Keys). Enables audiobook <-> EPUB sync (/audio);
# also needs KAVITA_API_KEY and a whisper.cpp server (docs/audio-sync.md).
AUDIOBOOKSHELF_TOKEN=
# Optional: POST {"event", "device", "file"} here when a file actually reaches a device,
# e.g. a Home Assistant webhook: http://homeassistant.local:8123/api/webhook/<your-webhook-id>
NOTIFY_URL=
